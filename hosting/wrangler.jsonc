{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telos-hosting",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "telos.wingit.tech/api/*", "zone_name": "wingit.tech" },
    { "pattern": "telos.wingit.tech/hosting-assets/*", "zone_name": "wingit.tech" },
    {
      "pattern": "telos.wingit.tech/account*",
      "zone_name": "wingit.tech"
    },
    {
      "pattern": "tls.wingit.tech/*",
      "zone_name": "wingit.tech"
    }
  ],
  "observability": {
    "enabled": true
  },
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCOUNT_ORIGIN": "https://telos.wingit.tech",
    "MODEL_DOMAIN": "tls.wingit.tech",
    "ORIGIN_ZONE": "wingit.tech",
    "EMAIL_FROM": "accounts@telos.wingit.tech",
    "CF_ACCOUNT_ID": "a005ae9db864d4dae31fcd17bc48d859",
    "CF_ZONE_ID": "40b3320eef7a7baea02075f7cfc29b4c",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telos-hosting",
      "database_id": "b22dd5c1-f0e7-4904-a90a-d71d686d8042",
      "migrations_dir": "migrations"
    }
  ]
}
